# Configuration de la base de données MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ivoka_db
DB_USER=ivoka_user
DB_PASSWORD=your_password_here

# Origines CORS autorisées (séparées par des virgules)
# En développement : http://localhost:3000
# En production : l'URL de votre serveur
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# URL de l'API (utilisée par le frontend React)
REACT_APP_API_URL=http://localhost:8080/ivoka-api/api
